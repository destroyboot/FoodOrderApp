@{
    ViewData["Title"] = "SignalR Test";
    // Change this to your API URL/port:
    var hubUrl = "https://localhost:7234/hubs/orders";
}

<h2>SignalR Test (Orders Hub)</h2>

<p>
    Hub URL: <code id="hubUrl">@hubUrl</code>
</p>

<div style="margin: 12px 0;">
    <label for="token" style="display:block; font-weight:600;">JWT (paste Bearer token value WITHOUT the word "Bearer")</label>
    <textarea id="token" rows="4" style="width: 100%; max-width: 900px;"></textarea>
</div>

<div style="margin: 12px 0;">
    <button id="connectBtn">Connect</button>
    <button id="disconnectBtn" disabled>Disconnect</button>
    <span id="status" style="margin-left: 10px; font-weight:600;">Disconnected</span>
</div>

<hr />

<h3>Events</h3>
<pre id="log" style="background:#111; color:#0f0; padding:12px; border-radius:6px; max-width:900px; height: 420px; overflow:auto;"></pre>

<!-- SignalR client via CDN -->
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>

<script>
    const hubUrl = document.getElementById("hubUrl").textContent.trim();
    const logEl = document.getElementById("log");
    const statusEl = document.getElementById("status");
    const connectBtn = document.getElementById("connectBtn");
    const disconnectBtn = document.getElementById("disconnectBtn");
    const tokenEl = document.getElementById("token");

    let connection = null;

    function log(msg, obj) {
        const line = `[${new Date().toISOString()}] ${msg}` + (obj ? `\n${JSON.stringify(obj, null, 2)}` : "");
        logEl.textContent = line + "\n\n" + logEl.textContent;
    }

    function setStatus(text, connected) {
        statusEl.textContent = text;
        connectBtn.disabled = connected;
        disconnectBtn.disabled = !connected;
    }

    async function connect() {
        const token = tokenEl.value.trim();
        if (!token) {
            alert("Paste JWT token first (without 'Bearer ').");
            return;
        }

        connection = new signalR.HubConnectionBuilder()
            .withUrl(hubUrl, {
                accessTokenFactory: () => token
            })
            .withAutomaticReconnect()
            .configureLogging(signalR.LogLevel.Information)
            .build();

        // Events from API
        connection.on("NewOrder", (payload) => {
            log("NewOrder received:", payload);
        });

        connection.on("OrderStatusChanged", (payload) => {
            log("OrderStatusChanged received:", payload);
        });

        connection.onreconnecting((err) => {
            log("Reconnecting...", err ? { message: err.message } : null);
            setStatus("Reconnecting...", false);
        });

        connection.onreconnected(() => {
            log("Reconnected.");
            setStatus("Connected", true);
        });

        connection.onclose((err) => {
            log("Disconnected.", err ? { message: err.message } : null);
            setStatus("Disconnected", false);
        });

        try {
            await connection.start();
            log("Connected to hub.");
            setStatus("Connected", true);
        } catch (err) {
            log("Failed to connect.", { message: err.message || err.toString() });
            setStatus("Disconnected", false);
        }
    }

    async function disconnect() {
        if (!connection) return;
        try {
            await connection.stop();
        } catch {}
        connection = null;
        setStatus("Disconnected", false);
    }

    connectBtn.addEventListener("click", connect);
    disconnectBtn.addEventListener("click", disconnect);

    setStatus("Disconnected", false);
</script>